{
  "name": "cleanframe",
  "version": "0.8.0",
  "private": true,
  "description": "A glassy, remote-first home screen for Samsung The Frame.",
  "author": "Tristan Franceschetti",
  "repository": "github:Shizub/cleanframe-tv",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "npm run lint && python3 scripts/check.py && npm run check:device && npm run check:motion && npm run check:sound",
    "package": "python3 scripts/package.py",
    "package:unsigned": "python3 scripts/package.py --unsigned",
    "tv:info": "python3 scripts/tv.py info",
    "tv:install": "python3 scripts/tv.py install",
    "tv:launch": "python3 scripts/tv.py launch",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "export:public": "python3 scripts/export-public.py",
    "check:public": "python3 scripts/check-public.py",
    "check:tools": "python3 -B scripts/test-tools.py",
    "lint": "eslint app",
    "check:device": "node --test scripts/test-device.mjs",
    "check:motion": "node --test scripts/test-motion.mjs",
    "check:sound": "node --test scripts/test-sound.mjs",
    "check:duo": "node scripts/check-duo.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "duo:add": "node scripts/duo-pack/add-wallpaper.mjs",
    "demo": "python3 scripts/build-demo.py"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
